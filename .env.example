# Modele du fichier .env de production (docker-compose.prod.yml).
# Copier en .env, remplir, et ne JAMAIS commiter .env (il est dans .gitignore).

# Nom de domaine public du site (ex. saes.exemple.sn). Caddy obtient le
# certificat HTTPS tout seul ; le domaine doit pointer vers le serveur et les
# ports 80 et 443 doivent etre ouverts. "localhost" = certificat local de test.
SAES_DOMAINE=localhost

# Base de donnees (choisir un mot de passe long et unique).
SAES_DB_USER=saes
SAES_DB_PASSWORD=

# Cle de signature des jetons de connexion : au moins 32 caracteres aleatoires.
# Par exemple : openssl rand -base64 48
SAES_JWT_SECRET=

# Premier administrateur (cree seulement si aucun n'existe ; 12 caracteres
# minimum). Retirer ces deux lignes une fois le compte cree.
SAES_ADMIN_EMAIL=
SAES_ADMIN_MOT_DE_PASSE=

# Connexion Google : Client ID OAuth (public). Ajouter https://SAES_DOMAINE aux
# "Origines JavaScript autorisees" dans Google Cloud Console.
SAES_GOOGLE_CLIENT_ID=628666152065-l7s82v42ttbh0qf3hk8vce6slon450br.apps.googleusercontent.com
